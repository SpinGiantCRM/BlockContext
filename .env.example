# Keep the real .env private. Never put a Hypixel key into ChatGPT or commit it.
BLOCKCONTEXT_MODE=demo
# Standard MCP transports: http (loopback Streamable HTTP) or stdio.
BLOCKCONTEXT_TRANSPORT=http
HYPIXEL_API_KEY=
# Default is a conservative 30. Set your assigned budget after verification.
HYPIXEL_REQUESTS_PER_5_MINUTES=30
# Optional ISO expiry with timezone for development keys, e.g. 2026-10-13T12:45:46+10:30.
HYPIXEL_API_KEY_EXPIRES_AT=
PORT=3008
# Always loopback; connect through an authenticated private tunnel.
BLOCKCONTEXT_DB=.data/cache.sqlite
# Reduce to 2 on small VPS deployments.
BLOCKCONTEXT_MAX_CONCURRENT=8
