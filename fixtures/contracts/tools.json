  {
    "name": "skyblock_reference",
    "title": "SkyBlock public resource definitions",
    "description": "Read official public collection tiers/unlocks, skill curves, full item definitions and requirements, mayor/election, Bingo, news, fire sales or recent ended auctions. Fixed endpoints, no authenticated player requests. Field paths, types, values and explicit truncation/omission coverage are paginated. Undocumented units and semantics remain unverified. Ended auctions are reported completed sales, distinct from active BIN asking prices. No private keys or player identities are exposed.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "collections",
            "skills",
            "items",
            "election",
            "bingo",
            "news",
            "fire_sales",
            "ended_auctions"
          ]
        },
        "itemId": {
          "type": "string",
          "pattern": "^[A-Z0-9_:.-]{1,96}$"
