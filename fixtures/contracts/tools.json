  {
    "name": "skyblock_client_context",
    "title": "SkyBlock client observations",
    "description": "Read owner-only latest snapshots from the optional passive client collector: an absorbed Huntaxe weapon and upgrades, separately classified bank balances, Cookie/God Potion remaining time when displayed, viewed storage/toolkit, minion and Garden menus. These are client observations, not Hypixel API data. Inspect source, timestamps, stale flags and partial coverage; timers are saved observations, not a live countdown. Current player inventory and selected tab facts are captured passively; server-unsent menu data requires manually opened supported menus; inventory item attributes and owner HUD/state are collected without opening menus. Mining, foraging, Hunting, experiments, pets, collections, accessories and quest menus provide selected typed numeric observations with partial coverage. This tool works without API access and never controls the game or requests data from Hypixel. Empty or unviewed storage remains unknown.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "player": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "Minecraft username or UUID. Do not provide URLs."
        },
        "profile": {
          "description": "Exact profile name displayed in the game, not a profile UUID.",
          "type": "string",
          "maxLength": 32
        },
        "section": {
          "type": "string",
          "enum": [
            "stats",
            "skills",
            "currencies",
            "slayers",
            "dungeons",
            "pets",
            "collections",
            "minions",
            "equipment",
            "accessories",
            "garden",
            "mining",
            "foraging",
            "hunting",
            "dailies",
            "quests",
            "rift",
            "crimson_isle",
            "chocolate_factory",
            "fishing",
            "bestiary",
            "travel",
            "profile_upgrades",
            "events",
            "orders",
            "museum",
            "api_fields",
            "storage",
            "data_contract",
            "systems"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "player"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
