[
  {
    "name": "skyblock_poll_schedule",
    "title": "Deferred profile checks",
    "description": "Save, list or remove operational checks attached to the next explicit profile snapshot request. No background polling, game actions or API calls when configuring checks. Daily UTC times are configurable; the HotM reset preset is a community reference, not a verified server reset. A due HotM check uses collector evidence and stays pending if its count is unknown. Other supported checks reuse the same requested profile snapshot. These settings store no personal goals or preferences.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "player": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "Minecraft username or UUID. Do not provide URLs."
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z ]{0,31}$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "set",
            "list",
            "remove"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,48}$"
        },
        "target": {
          "type": "string",
          "enum": [
            "hotm_bonus_commissions",
            "currencies",
            "stats",
            "skills",
            "mining",
            "dailies"
          ]
        },
        "cadence": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "daily_utc"
                },
                "timeUtc": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "required": [
                "kind",
                "timeUtc"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "once"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "kind",
                "at"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "hotm_reset_reference"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "player",
        "profile",
        "operation"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  {
    "name": "skyblock_profile_context",
    "title": "SkyBlock profile overview",
    "description": "Read a compact SkyBlock progression overview, with optional separately sourced client observations: capped skills, coins, API-reported cookie status and potion-effect coverage, slayers, Catacombs levels and next floor level gates, active pet levels and XP progress, equipped gear, calculated magical power, Garden and coverage. Garden has its own snapshot timestamp. Read factual progression; inspect calculation status, caps, timestamps and warnings. Default cached reads never refresh existing player snapshots; use snapshot only for an explicit occasional API check. Live API polling is rejected. Does not perform gameplay or track player histories.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "player": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "Minecraft username or UUID. Do not provide URLs."
        },
        "profile": {
          "description": "Exact profile name, such as Strawberry, or profile UUID. Omit to use the selected profile when unambiguous.",
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "mode": {
          "default": "cached",
          "description": "cached reads the existing snapshot without refresh. snapshot explicitly permits an on-demand API check. live is rejected; use skyblock_live_context.",
          "type": "string",
          "enum": [
            "cached",
            "snapshot",
            "live"
          ]
        }
      },
      "required": [
        "player"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "1.0"
            },
            "source": {
              "type": "string",
              "enum": [
                "hypixel",
                "synthetic_demo"
              ]
            },
            "retrievedAt": {
              "type": "string"
            },
            "ageSeconds": {
              "type": "number",
              "minimum": 0
            },
            "cache": {
              "type": "string",
              "enum": [
                "fresh",
                "miss",
                "stale"
              ]
            },
            "stale": {
              "type": "boolean"
            },
            "freshnessPolicy": {
              "type": "object",
              "properties": {
                "refreshAfterSeconds": {
                  "type": "number"
                },
                "maximumSnapshotAgeSeconds": {
                  "type": "number"
                },
                "refreshOnlyOnRequest": {
                  "type": "boolean",
                  "const": true
                },
                "livePollingAllowed": {
                  "type": "boolean",
                  "const": false
                }
              },
              "required": [
                "refreshAfterSeconds",
                "maximumSnapshotAgeSeconds",
                "refreshOnlyOnRequest",
                "livePollingAllowed"
              ],
              "additionalProperties": false
            },
            "upstreamFreshness": {
              "type": "string"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "schemaVersion",
            "source",
            "retrievedAt",
            "ageSeconds",
            "cache",
            "stale",
            "freshnessPolicy",
            "upstreamFreshness",
            "warnings"
          ],
          "additionalProperties": false
        },
        "scheduledChecks": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "player": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "uuid",
            "name"
          ],
          "additionalProperties": false
        },
        "profile": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "selected": {
              "type": "boolean"
            },
            "gameMode": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "selected",
            "gameMode"
          ],
          "additionalProperties": false
        },
        "availableProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "selected": {
                "type": "boolean"
              },
              "gameMode": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "selected",
              "gameMode"
            ],
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "available",
              "partial",
              "unavailable"
            ]
          }
        },
        "summary": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "metadata",
        "player",
        "profile",
        "availableProfiles",
        "coverage",
        "summary"
      ],
      "additionalProperties": false
    }
