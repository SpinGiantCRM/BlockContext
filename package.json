{
  "name": "blockcontext",
  "version": "0.8.0",
  "private": true,
  "description": "Player-facing Hypixel SkyBlock context over MCP",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:demo": "node dist/src/demo-main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm test && npm audit --omit=dev",
    "smoke": "node --env-file-if-exists=.env dist/src/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "prismarine-nbt": "2.8.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "files": [
    "dist/src/*.js",
    "fixtures/",
    ".env.example",
    "docs/SELF-HOSTING.md",
    "docs/HYPIXEL-SETUP.md",
    "docs/THIRD-PARTY.md"
  ],
  "license": "MIT"
}
